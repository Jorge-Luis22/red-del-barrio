# Copia este archivo como .env.local y rellena solo lo que tengas listo.
# La app funciona SIN backend: usa SQLite local + chat simulado.
# Al rellenar estas variables, cambia a Supabase y Matrix reales sin tocar la UI.

# --- Supabase (fuente de verdad del servidor) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Matrix / Synapse (chat) ---
# Si falta cualquiera de las dos, el chat corre en modo local (demo).
VITE_MATRIX_HOMESERVER=https://matrix.tudominio.pe
VITE_MATRIX_TOKEN=

# --- App ---
VITE_DEFAULT_ZONE=Los Olivos, Lima
VITE_DEFAULT_LAT=-11.9890
VITE_DEFAULT_LNG=-77.0710

# --- Piloto con vecinos reales (ver docs/PILOTO.md) ---
# VITE_APP_MODE=pilot   → cuentas automáticas + código del barrio, sin datos de ejemplo.
# Sin esta variable la app es la demo (vecinos de ejemplo) que usa el jurado.
VITE_APP_MODE=
# Correo que ven los vecinos en "Términos y privacidad" para dudas, reportes y pedir que borren sus datos.
VITE_CONTACT_EMAIL=
